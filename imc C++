#include <iostream>
#include <iomanip>

int main() {
    double peso, altura;

    std::cout << "Digite o peso (kg): ";
    std::cin >> peso;

    std::cout << "Digite a altura (m): ";
    std::cin >> altura;

    double imc = peso / (altura * altura);

    std::cout << std::fixed << std::setprecision(2);
    std::cout << "IMC: " << imc << "\n";

    if (imc < 18.5) {
        std::cout << "Classificação: Abaixo do peso\n";
    } else if (imc < 25) {
        std::cout << "Classificação: Peso normal\n";
    } else if (imc < 30) {
        std::cout << "Classificação: Sobrepeso\n";
    } else {
        std::cout << "Classificação: Obesidade\n";
    }

    return 0;
}
